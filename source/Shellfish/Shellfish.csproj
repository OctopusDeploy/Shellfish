<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>Octopus Deploy</Authors>
    <AssemblyName>Octopus.Shellfish</AssemblyName>
    <RootNamespace>Octopus.Shellfish</RootNamespace>
    <PackageProjectUrl>https://github.com/OctopusDeploy/Shellfish</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <DisableImplicitPackageTargetFallback>true</DisableImplicitPackageTargetFallback>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>
    <!--
      net8.0 is shipped even though tests only run against net10.0 (and net472 on Windows).
      Without it, net8 consumers would fall back to the netstandard2.0 build, which takes the
      !NET5_0_OR_GREATER code paths: ExecuteAsync blocks synchronously on Process.WaitForExit,
      and arguments go through the PasteArguments polyfill instead of ProcessStartInfo.ArgumentList.
      net8.0 compiles the same #if branches as net10.0, so the net10.0 tests cover its behaviour.
    -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.1" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
